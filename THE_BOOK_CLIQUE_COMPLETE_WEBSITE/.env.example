# =============================================================================
# THE BOOK CLIQUE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' before starting the website locally:
#    cp .env.example .env
# 2. Fill in your actual configuration values below.
# 3. For security, never commit your real '.env' file or private credentials
#    to any public or shared repository.
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Owner Administrator Account (Full-Stack Backend Authorisation)
# - ADMIN_EMAIL: Must match the registered email for owner access.
# - ADMIN_OWNER_UID: The exact Firebase User UID corresponding to the owner account.
#   (Current configured owner: hollowaylydia.us@gmail.com / UID: P7NJg0sVJwM7PEdwKB0JpQ0NIi62)
# - ADMIN_PASSWORD: Strong fallback passkey used for administrative authorization.
ADMIN_EMAIL=hollowaylydia.us@gmail.com
ADMIN_OWNER_UID=P7NJg0sVJwM7PEdwKB0JpQ0NIi62
ADMIN_PASSWORD=your_secure_admin_passkey_here

# Client-Side Firebase Configuration (Prefix with VITE_ for browser visibility)
# Obtain these values from your Firebase Console > Project Settings > General > Your apps (Web)
VITE_ADMIN_EMAIL=hollowaylydia.us@gmail.com
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional: Firebase Admin SDK Service Account (Server-Side)
# Either paste the raw JSON string or provide a file path to serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'

# Email Service Configuration (for Author Enquiries & Reader Verification)
# Option A: Direct Gmail via Google Account App Password (16 characters)
GMAIL_USER=thebookclique.official@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Option B: Custom SMTP Gateway (SendGrid, Mailgun, Amazon SES, Postmark, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thebookclique.official@gmail.com
SMTP_PASS=your_smtp_password
SMTP_FROM="The Book Clique <thebookclique.official@gmail.com>"
SMTP_SECURE=false

# Optional: Google Gemini AI API Key (if generative assistant features are invoked)
GEMINI_API_KEY=your_gemini_api_key_here
